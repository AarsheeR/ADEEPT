int duration = 500;  // 500 miliseconds
 
void setup() {
 
}
 
void loop() {  
  for (int thisNote = 0; thisNote < 7; thisNote++) {
    // pin8 output the voice, every scale is 0.5 sencond
    tone(8, melody1[thisNote], duration);    
  
