// Passive buzzer - more control over the sound (pitch)
// constant sound

int buzzerPin = 3;

void setup() {
  // put your setup code here, to run once:
  pinMode(buzzerPin, OUTPUT);
}

void loop() {
  // put your main code here, to run repeatedly:
  digitalWrite(buzzerPin, HIGH);
  delay(5);
  digitalWrite(buzzerPin, LOW);
  delay(5); // adjust the delay time to adjust the pitch (highest pitch -> 1)
}
