int analogPort = A0;
int sensorValue = 0;

int led = 7;

void setup() {
  Serial.begin(9600);
  pinMode(led, OUTPUT);
}

void loop() {
  sensorValue = analogRead(analogPort);
  Serial.print("Analog value: ");
  Serial.println(sensorValue);
  if (sensorValue < 50){
    digitalWrite(led, HIGH);
  }
  else
  {
    digitalWrite(led,LOW);
  }
  delay(200);
}
